{
  "name": "vortymc-launcher",
  "version": "1.0.0",
  "description": "VortyMC Launcher - A sleek Minecraft launcher with purple neon aesthetic",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "lint": "eslint src/"
  },
  "author": "VortyYT",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0",
    "eslint": "^8.56.0"
  },
  "dependencies": {
    "@azure/msal-node": "^2.6.0",
    "adm-zip": "^0.5.10",
    "axios": "^1.6.0",
    "uuid": "^9.0.0"
  },
  "build": {
    "appId": "com.vortymc.launcher",
    "productName": "VortyMC-Launcher",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.png"
    }
  }
}
